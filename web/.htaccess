Options -MultiViews
RewriteEngine On
RewriteBase /

# 0. MCP Routing -> api/index.php
RewriteRule ^mcp/?(.*)$ api/index.php?mcp=1 [QSA,L]
RewriteRule ^\.well-known/mcp/server-card\.json$ api/index.php?server_card=1 [QSA,L]

# 1. API Routing -> api/index.php
RewriteRule ^api/v1/(.*)$ api/index.php [QSA,L]
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# 2. Block access to SQLite database and data directory
RewriteRule ^api/data - [F,L]
RewriteRule \.sqlite$ - [F,L]

# 3. Clean URLs for static HTML pages (.html suffix removal)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 4. Standard 404 Fallback
ErrorDocument 404 /404.html

# 5. Browser Caching & Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
