{
  "manifest_version": 3,
  "name": "gecici.email — Tek Kullanımlık Geçici E-posta & OTP",
  "short_name": "gecici.email",
  "version": "1.1.0",
  "description": "Tek tıkla izsiz geçici e-posta üretin, formlara sağ tıkla otomatik yapıştırın ve OTP doğrulama kodlarını anında yakalayın.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "gecici.email Konsolu"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gecici.email/*"
  ]
}
