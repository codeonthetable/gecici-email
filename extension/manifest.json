{
  "manifest_version": 3,
  "name": "gecici.email — Tek Kullanımlık Geçici E-posta",
  "short_name": "gecici.email",
  "version": "1.0.0",
  "description": "Tek tıkla izsiz geçici e-posta üretin, gelen kutunuzu izleyin ve doğrulama kodlarını (OTP) anında kopyalayın.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "gecici.email Konsolu"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://gecici.email/*"
  ]
}
